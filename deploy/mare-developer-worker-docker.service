[Unit]
Description=MWS isolated Developer worker (rootless Docker)
After=docker.service
Requires=docker.service

[Service]
Type=simple
# User unit belonging to the dedicated mws-worker rootless Docker account.
EnvironmentFile=%h/.config/mws-worker/environment
WorkingDirectory=/opt/mws-worker
ExecStart=/usr/bin/python3 -m developer_worker.supervisor --engine docker --socket /run/mws-developer/worker.sock --work %h/jobs --image ${MARE_DEVELOPER_IMAGE} --api-origin ${MARE_WORKER_API_ORIGIN}
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0007

[Install]
WantedBy=default.target
