# Empty (default) serves at /. A single / is also equivalent to empty.
MWS_BASE_PATH=
# Comma-separated immediate proxy IPs/CIDRs. Empty trusts no forwarded headers.
MWS_TRUSTED_PROXIES=
# Enable only behind HTTPS:
MARE_SECURE_COOKIES=0
# Optional absolute persistent data directory; default is <installation>/data.
# MARE_DATA_DIR=/var/lib/mws/data
# MARE_SECRET_KEY=replace-with-a-random-secret-or-use-generated-data/session.key
