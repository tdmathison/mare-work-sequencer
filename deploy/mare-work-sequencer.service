[Unit]
Description=MARE Work Sequencer
After=network.target
[Service]
User=mare-work-sequencer
Group=mare-work-sequencer
WorkingDirectory=/opt/mare-work-sequencer
Environment=MARE_SECURE_COOKIES=1
ExecStart=/opt/mare-work-sequencer/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 app:app
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/mare-work-sequencer/data
[Install]
WantedBy=multi-user.target
