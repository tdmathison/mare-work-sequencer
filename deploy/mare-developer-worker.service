[Unit]
Description=MARE isolated Developer worker (rootless Podman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Install as a user service for the dedicated mws-worker account. Configure its
# rootless Podman subordinate IDs and shared Unix-socket group before starting.
EnvironmentFile=%h/.config/mws-worker/environment
ExecStart=/usr/bin/python3 -m developer_worker.supervisor --socket /run/mws-developer/worker.sock --work %h/jobs --image ${MARE_DEVELOPER_IMAGE} --api-origin ${MARE_WORKER_API_ORIGIN}
WorkingDirectory=/opt/mws-worker
Restart=on-failure
RestartSec=5
UMask=0007

[Install]
WantedBy=default.target
