FROM python:3.12-slim
# Build this administrator-reviewed image on the worker, then configure its immutable digest.
RUN pip install --no-cache-dir httpx==0.28.1 packaging==26.0
COPY sdk /opt/sdk
RUN pip install --no-cache-dir /opt/sdk && rm -rf /opt/sdk
COPY plugin_runtime/runtime.py /opt/mws/runtime.py
RUN mkdir /work /gateway /snapshot && chmod 1777 /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python","/opt/mws/runtime.py"]
