FROM python:3.12-slim
# Build this administrator-reviewed image on the worker, then configure its immutable digest.
RUN pip install --no-cache-dir basedpyright==1.38.4 debugpy==1.8.20 pytest==9.0.2 httpx==0.28.1 packaging==26.0
COPY sdk /opt/sdk
RUN pip install --no-cache-dir /opt/sdk && rm -rf /opt/sdk
COPY developer_worker/runtime.py /opt/mws/runtime.py
RUN mkdir /work /gateway /snapshot && chmod 1777 /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
RUN printf 'from runtime import run\nrun()\n' > /opt/mws/debug_launcher.py
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python","/opt/mws/runtime.py"]
