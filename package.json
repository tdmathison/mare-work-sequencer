{
  "name": "mare-work-sequencer-editors",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:editors": "esbuild frontend/markdown-editor.js --bundle --minify --format=iife --target=es2020 --supported:template-literal=false --outfile=static/vendor/codemirror/markdown-editor.js --legal-comments=external && esbuild frontend/text-worker.js --bundle --minify --format=iife --target=es2020 --outfile=static/text-worker.js && node frontend/build-notices.cjs",
    "test:editors": "node tests/browser/markdown-editor.cjs",
    "build:api-docs": "node frontend/build-api-docs.cjs",
    "test:api-docs": "node tests/browser/api-documentation.cjs",
    "build:explorer": "node frontend/build-explorer-vendor.cjs",
    "test:explorer": "node tests/browser/data-explorer.cjs",
    "test:explorer-selection": "node tests/browser/explorer-selection.cjs",
    "test:explorer-research": "node tests/browser/explorer-research.cjs",
    "test:explorer-coverage": "node tests/browser/explorer-coverage.cjs",
    "test:developer": "node tests/browser/developer-workspace.cjs",
    "test:developer-explorer": "node tests/browser/developer-explorer.cjs",
    "test:developer-language": "node tests/browser/developer-language.cjs",
    "test:developer-debug": "node tests/browser/developer-debug.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "cytoscape": "3.33.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "swagger-ui-dist": "5.33.3"
  },
  "engines": {
    "node": ">=20"
  }
}
